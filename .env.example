# مفتاح Claude من https://console.anthropic.com — بدونه يعمل الوكلاء بالقواعد البرمجية فقط
ANTHROPIC_API_KEY=

# sim = محاكاة بأسعار وهمية (افتراضي) | demo = تجريبي بأسعار حقيقية وفلوس وهمية | ibkr = Interactive Brokers
NEXS_BROKER=sim
IBKR_HOST=127.0.0.1
IBKR_PORT=4002  # 4002 = IB Gateway تجريبي، 7497 = TWS تجريبي
IBKR_CLIENT_ID=17
IBKR_MARKET_DATA_TYPE=3  # 3 = بيانات متأخرة مجانية، 1 = حية (تحتاج اشتراك بيانات)

# لا تفعّل هذا إلا وأنت متأكد: يسمح بأوامر على حساب حقيقي
NEXS_ALLOW_LIVE=0

# إذا فتحت الواجهة خارج جهازك، ضع كلمة سر وافتح: http://host:8000/?token=...
NEXS_TOKEN=
NEXS_HOST=127.0.0.1
NEXS_PORT=8000

# كلمة سر تنبيهات TradingView (أي نص طويل عشوائي): ضعها في رسالة التنبيه كـ "secret"
NEXS_TV_SECRET=
